{
    "name": "feature-request-system",
    "version": "1.0.0",
    "private": true,
    "description": "Blocks and front-end scripts for the Feature Request System WordPress plugin.",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "wp-scripts build --experimental-modules --webpack-src-dir=blocks --output-path=build --webpack-copy-php",
        "start": "wp-scripts start --experimental-modules --webpack-src-dir=blocks --output-path=build --webpack-copy-php",
        "lint:js": "wp-scripts lint-js blocks assets tests/e2e",
        "lint:css": "wp-scripts lint-style \"blocks/**/*.scss\"",
        "format": "wp-scripts format blocks assets tests/e2e",
        "env": "wp-env",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
        "postinstall": "patch-package"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@wordpress/block-editor": "^18.0.0",
        "@wordpress/blocks": "^16.1.0",
        "@wordpress/components": "^41.0.0",
        "@wordpress/core-data": "^8.1.0",
        "@wordpress/data": "^10.56.0",
        "@wordpress/e2e-test-utils-playwright": "^2.1.0",
        "@wordpress/element": "^8.8.0",
        "@wordpress/env": "^11.16.0",
        "@wordpress/html-entities": "^4.56.0",
        "@wordpress/i18n": "^6.29.0",
        "@wordpress/interactivity": "^6.56.0",
        "@wordpress/scripts": "^36.0.0",
        "@wordpress/server-side-render": "^6.32.0",
        "patch-package": "^8.0.1"
    },
    "overrides": {
        "@wordpress/env": {
            "js-yaml": {
                "argparse": "^2.0.1"
            }
        },
        "katex": "^0.18.2",
        "markdownlint-cli": {
            "js-yaml": "^5.4.1"
        },
        "postcss-selector-parser": "^7.1.6",
        "qs": "^6.16.1",
        "serialize-javascript": "^7.0.5",
        "simple-git": "^4.0.2",
        "smol-toml": "^1.9.1",
        "sockjs": {
            "uuid": "^11.1.1"
        }
    }
}
