<?xml version="1.0"?>
<ruleset name="Feature Request System">
	<description>WordPress Coding Standards with PSR-4 file names and short array syntax.</description>

	<file>feature-request-system.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>
	<file>blocks</file>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress">
		<!-- Class files use PSR-4 names such as Plugin.php instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is the house style; long arrays are disallowed below. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="feature-request-system"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mwtfrs"/>
				<element value="FeatureRequestSystem"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
