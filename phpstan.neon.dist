parameters:
	level: 6
	phpVersion:
		min: 70400
		max: 80599
	paths:
		- feature-request-system.php
		- uninstall.php
		- src
	bootstrapFiles:
		- tests/phpstan/constants.php
	scanFiles:
		- tests/phpstan/akismet.php
		- tests/phpstan/wp-cli.php
	dynamicConstantNames:
		- COOKIEPATH
		- COOKIE_DOMAIN
		- WP_CLI
	ignoreErrors:
		# The requirements check exists for sites running PHP below the supported minimum.
		-
			identifier: booleanOr.leftAlwaysFalse
			path: feature-request-system.php
