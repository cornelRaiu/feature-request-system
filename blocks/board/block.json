{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mwtfrs/board",
	"version": "0.1.0",
	"title": "Feature Request Board",
	"category": "widgets",
	"icon": "lightbulb",
	"description": "Feature requests that people can search, filter and vote on.",
	"keywords": [ "feature request", "roadmap", "vote", "feedback", "ideas" ],
	"textdomain": "feature-request-system",
	"attributes": {
		"board": {
			"type": "integer",
			"default": 0
		},
		"perPage": {
			"type": "integer",
			"default": 20
		}
	},
	"supports": {
		"html": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
