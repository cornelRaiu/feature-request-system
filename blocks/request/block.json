{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mwtfrs/request",
	"version": "0.1.0",
	"title": "Feature Request Details",
	"category": "theme",
	"icon": "thumbs-up",
	"description": "The vote button, status and categories of the feature request being viewed. For the template of a single feature request.",
	"keywords": [ "feature request", "vote", "status" ],
	"textdomain": "feature-request-system",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"interactivity": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
